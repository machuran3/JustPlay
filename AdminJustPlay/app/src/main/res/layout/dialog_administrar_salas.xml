<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1A1C29"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏗️ Aumentar Salas y Puestos"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnCerrarGestionSalas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#A0A0A0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agrega nuevas salas, puestos de autitos o salas Just Dance al tablero en vivo:"
                android:textColor="#A0A0A0"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnAbrirGestionSecciones"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📁 Administrar Secciones (VR, Volantes, etc.)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2D3349"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"/>

            <!-- 1. AUMENTAR MINICINE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#24283B"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Aumentar Sala Minicine"
                        android:textColor="#DEFF9A"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etNumeroNuevaSalaCine"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro de Sala (Ej. 16)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:backgroundTint="#DEFF9A"
                            android:inputType="number"
                            android:textSize="14sp"/>

                        <Button
                            android:id="@+id/btnAgregarSalaCine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Agregar"
                            android:backgroundTint="#DEFF9A"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. AUMENTAR AUTITOS (VOLANTES) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#24283B"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏎️ Aumentar Simulador (Autito / Volante)"
                        android:textColor="#DEFF9A"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etNumeroNuevoAutito"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro de Car (Ej. 9 para Car 9)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:backgroundTint="#DEFF9A"
                            android:inputType="number"
                            android:textSize="14sp"/>

                        <Button
                            android:id="@+id/btnAgregarAutito"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Agregar"
                            android:backgroundTint="#DEFF9A"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. AUMENTAR JUST DANCE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#24283B"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💃 Aumentar Puesto Just Dance"
                        android:textColor="#DEFF9A"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etNumeroNuevoDance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro de Dance (Ej. 2)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:backgroundTint="#DEFF9A"
                            android:inputType="number"
                            android:textSize="14sp"/>

                        <Button
                            android:id="@+id/btnAgregarDance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Agregar"
                            android:backgroundTint="#DEFF9A"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. AUMENTAR SALA EN CUALQUIER SECCIÓN DINÁMICA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#24283B"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 Aumentar Sala por Sección Dinámica"
                        android:textColor="#DEFF9A"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona la sección:"
                        android:textColor="#A0A0A0"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"/>

                    <Spinner
                        android:id="@+id/spSeccionParaNuevaSala"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etNumeroNuevaSalaDinamica"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro de Puesto (Ej. 1, 2, 3...)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:backgroundTint="#DEFF9A"
                            android:inputType="number"
                            android:textSize="14sp"/>

                        <Button
                            android:id="@+id/btnAgregarSalaDinamica"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Agregar"
                            android:backgroundTint="#DEFF9A"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ACCIONES RÁPIDAS DE ELIMINACIÓN MASIVA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnEliminarTodosAutitos"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🗑️ Borrar TODOS los Autitos"
                    android:textColor="#FF5252"
                    android:backgroundTint="#24283B"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnEliminarTodasSalas"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🗑️ Borrar TODO Minicine"
                    android:textColor="#FF5252"
                    android:backgroundTint="#24283B"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- LISTA DE SALAS ACTUALES PARA ELIMINAR / QUITAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salas y Puestos Actuales (Toca para eliminar):"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/llContenedorSalasEliminar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
