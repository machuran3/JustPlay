<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDialogAuditTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ Auditoría"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogAuditContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 eventos"
                android:textColor="#000000"
                android:background="#DEFF9A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/btnDialogAuditCerrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#A0A0A0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogAuditSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de operaciones: responsable, hora exacta, importes y estado."
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- PESTAÑAS ACTIVOS / BORRADOS / TODOS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAuditFiltroActivos"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🟢 Activos"
                    android:textSize="11sp"
                    android:backgroundTint="#DEFF9A"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"/>

                <Button
                    android:id="@+id/btnAuditFiltroBorrados"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🗑️ Borrados (Papelera)"
                    android:textSize="11sp"
                    android:backgroundTint="#24283B"
                    android:textColor="#FF5252"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"/>

                <Button
                    android:id="@+id/btnAuditFiltroTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📋 Todo el Historial"
                    android:textSize="11sp"
                    android:backgroundTint="#24283B"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- FILTROS FECHA Y RANGO DE HORAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnAuditFiltroFecha"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="📅 Fecha: Todas"
                    android:backgroundTint="#24283B"
                    android:textColor="#DEFF9A"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnAuditLimpiarFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🔄 Todas"
                    android:backgroundTint="#1A1C29"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnAuditHoraInicio"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⏰ Desde: Inicio"
                    android:backgroundTint="#24283B"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>

                <Button
                    android:id="@+id/btnAuditHoraFin"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⏰ Hasta: Fin"
                    android:backgroundTint="#24283B"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"/>

                <Button
                    android:id="@+id/btnAuditLimpiarHoras"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="✕ Horas"
                    android:backgroundTint="#1A1C29"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CHECKBOXES DE FILTROS TICKEABLES POR SECCIÓN -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbAuditCine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 Cines"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:checked="true"/>

                <CheckBox
                    android:id="@+id/cbAuditAutitos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏎️ Autitos"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:checked="true"
                    android:layout_marginStart="8dp"/>

                <CheckBox
                    android:id="@+id/cbAuditDance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💃 Just Dance"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:checked="true"
                    android:layout_marginStart="8dp"/>

                <LinearLayout
                    android:id="@+id/llAuditFiltrosSeccionesDinamicas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- BUSCADOR RÁPIDO EN TIEMPO REAL -->
        <EditText
            android:id="@+id/etDialogAuditBuscar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="🔍 Buscar por cliente, celular, sala..."
            android:textColor="#FFFFFF"
            android:textColorHint="#787C99"
            android:textSize="13sp"
            android:background="#24283B"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:singleLine="true" />

        <!-- RESUMEN DE TOTALES -->
        <TextView
            android:id="@+id/tvDialogAuditResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DEFF9A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- CONTENEDOR CON SCROLL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llDialogAuditContenedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogAuditEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando registros de auditoría..."
                    android:textColor="#DEFF9A"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="24dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.cardview.widget.CardView>
