<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💸 Salida de Caja / Egreso"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCerrarNuevoEgreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#A0A0A0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registra compras operativas, insumos o retiros con trazabilidad:"
                android:textColor="#888899"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- MONTO DEL EGRESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#24283B"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Bs."
                    android:textColor="#FF5252"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etMontoEgreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textColor="#FF5252"
                    android:textColorHint="#66FF5252"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CHIPS DE MONTOS RÁPIDOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnPresetEgreso10"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#2D3349"
                    android:text="10 Bs"
                    android:textColor="#DEFF9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnPresetEgreso20"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#2D3349"
                    android:text="20 Bs"
                    android:textColor="#DEFF9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnPresetEgreso50"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#2D3349"
                    android:text="50 Bs"
                    android:textColor="#DEFF9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnPresetEgreso100"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2D3349"
                    android:text="100 Bs"
                    android:textColor="#DEFF9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- CATEGORÍA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏷️ Categoría de Gasto"
                android:textColor="#DEFF9A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spCategoriaEgreso"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#24283B"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="14dp" />

            <!-- CONCEPTO / DESCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Detalle / Motivo del Gasto"
                android:textColor="#DEFF9A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDescripcionEgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:background="#24283B"
                android:gravity="top|start"
                android:hint="Ej: Servilletas, ambientadores, pilas para controles, limpieza..."
                android:textColorHint="#787C99"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:layout_marginBottom="14dp" />

            <!-- ORIGEN DE FONDOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💳 Origen de los Fondos"
                android:textColor="#DEFF9A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgMetodoEgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbEgresoEfectivo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💵 Efectivo (Caja)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbEgresoQR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 QR / Cuenta"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- BOTÓN GUARDAR -->
            <Button
                android:id="@+id/btnConfirmarEgreso"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#FF5252"
                android:text="💸 Confirmar Salida de Caja"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
