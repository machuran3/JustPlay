<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAuditoria"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="2dp"
    app:cardBackgroundColor="#24283B"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- FILA SUPERIOR: FECHA Y BADGE DE ACCION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAuditFechaHora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="11/11/2026 19:00:00"
                android:textColor="#DEFF9A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuditBadgeAccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ INICIO_TIEMPO"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1A1C29"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- TITULO PRINCIPAL -->
        <TextView
            android:id="@+id/tvAuditTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 Sala 1 (Minicine)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <!-- RESPONSABLE / USUARIO -->
        <TextView
            android:id="@+id/tvAuditResponsable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Responsable: Juan Pérez (Empleado)"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />

        <!-- DISPOSITIVO / TERMINAL -->
        <TextView
            android:id="@+id/tvAuditDispositivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Dispositivo: Samsung A54 (ID: POS-01)"
            android:textColor="#DEFF9A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- DETALLES ADICIONALES (TIEMPO, PELÍCULA, STOCK, PRECIO, CAMBIOS) -->
        <TextView
            android:id="@+id/tvAuditDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Tiempo: 60 min | Película: Avatar 2"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />

        <!-- RESALTADO EXTRA O PILL DE ESTADO / TOTAL -->
        <LinearLayout
            android:id="@+id/llAuditHighlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvAuditHighlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Cobrado: 35.0 Bs"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
