<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAuditoriaEvento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- CABECERA: BADGE DE TIPO Y FECHA/HORA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvAuditBadgeTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 VENTA"
                android:textColor="#000000"
                android:background="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAuditFechaHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 15/11/2026 14:30"
                android:textColor="#DEFF9A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECCIÓN DESTACADA: USUARIO RESPONSABLE Y DISPOSITIVO -->
        <LinearLayout
            android:id="@+id/llAuditUsuarioBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#24283B"
            android:padding="8dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvAuditUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧑‍💼 Usuario: Juan (Empleado)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuditDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Dispositivo: Samsung SM-A525M"
                android:textColor="#B0B5D0"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TITULO / ELEMENTO O SALA -->
        <TextView
            android:id="@+id/tvAuditElemento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬 Sala 1 - Minicine"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- CLIENTE Y CELULAR -->
        <TextView
            android:id="@+id/tvAuditCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Cliente: Mario Gómez (📱 Cel: 70123456)"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <!-- MONTO Y METODO DE PAGO -->
        <TextView
            android:id="@+id/tvAuditMontoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Cobrado: 25.0 Bs (💵 Efectivo)"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- DETALLES ADICIONALES / MODIFICACIONES / MOTIVO -->
        <TextView
            android:id="@+id/tvAuditDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Tiempo: 1h 00m | Película: Transformers | Pedidos: 1x Pipocas (10 Bs)"
            android:textColor="#A0A0A0"
            android:textSize="11sp" />

        <!-- BOTÓN VER COMPROBANTE (SI APLICA) -->
        <TextView
            android:id="@+id/btnVerComprobanteAudit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Ver Comprobante"
            android:textColor="#DEFF9A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#2E334D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
