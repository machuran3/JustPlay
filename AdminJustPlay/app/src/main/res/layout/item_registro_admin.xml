<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRegistroAdmin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BANNER DE REGISTRO ELIMINADO (AUDITORIA) -->
        <LinearLayout
            android:id="@+id/llBannerEliminado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#D32F2F"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvInfoEliminacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ BORRADO DE BD\nPor: Operador | Fecha: 20/08 21:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestaurarRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Restaurar"
                android:textSize="11sp"
                android:backgroundTint="#DEFF9A"
                android:textColor="#000000"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/llDatosRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btnEliminarRegistro"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvRegFechaHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#DEFF9A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRegMetodoPago"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="📱 QR"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#2A2C39"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRegTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvRegCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A0A0A0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRegDetalles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Película: Spiderman | Tiempo: 120m"
                    android:textColor="#A0A0A0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRegVolantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏎️ Volantes: 1"
                    android:textColor="#DEFF9A"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvRegPedidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedidos: Maruchan"
                    android:textColor="#A0A0A0"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvRegTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: 35.0 Bs"
                        android:textColor="#00E676"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVerComprobanteRegistro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="📷 Ver Comprobante"
                        android:textColor="#DEFF9A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#24283B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnEliminarRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:text="🗑️"
                android:textSize="22sp" />
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
