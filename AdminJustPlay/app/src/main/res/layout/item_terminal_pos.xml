<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTerminalPos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BANNER REVOCADO -->
        <TextView
            android:id="@+id/tvBannerTerminalRevocada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D32F2F"
            android:text="🚫 ACCESO REVOCADO • COMPUTADORA BLOQUEADA"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FILA SUPERIOR: ICONO + NOMBRE + ESTADO EN LÍNEA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 "
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreTerminalPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Caja Principal (PC Mostrador)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIdTerminalPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: POS-PC-98F1A2"
                        android:textColor="#787C99"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEstadoConexionTerminal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 En Línea"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#1B3E2B"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- DETALLES DE HARDWARE Y RED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#24283B"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvHostnameIP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌐 Hostname: PC-VENTAS | IP: 192.168.1.35"
                    android:textColor="#DEFF9A"
                    android:textSize="12sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvOSVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Sistema: Linux 6.8 (x86_64) • JustPlay POS v1.0.0"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvUltimoHeartbeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Último latido: Hace 5 segundos (12/11 22:30)"
                    android:textColor="#787C99"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- BOTONES DE ACCION RÁPIDA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRenombrarTerminal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#2D3349"
                    android:text="✏️ Renombrar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleAutorizarTerminal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D32F2F"
                    android:text="🚫 Desactivar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
