<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardUsuario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BANNER DE BLOQUEADO O EXPIRADO -->
        <TextView
            android:id="@+id/tvBannerBloqueado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚫 DISPOSITIVO DESACTIVADO / ACCESO EXPIRADO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#D32F2F"
            android:paddingVertical="4dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- AVATAR CIRCULAR CON INICIAL -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#24283B">
                <TextView
                    android:id="@+id/tvAvatarInicial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="E"
                    android:textColor="#DEFF9A"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvNombreUsuario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cajero 1 - Juan"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvEstadoConexion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 En Línea"
                        android:textColor="#00E676"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="#1B3E2B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvRolApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Empleado • Employ_JustPlay"
                        android:textColor="#DEFF9A"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tvPinDispositivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔑 PIN: 0001"
                        android:textColor="#A0A0A0"
                        android:textSize="11sp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTiempoRestanteAcceso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Acceso: Permanente"
                    android:textColor="#FFC107"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvDispositivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Samsung Galaxy A54"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvSeccionActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 En Tablero"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvUltimaActividad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activo en este momento"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- BOTON RAPIDO PARA DESACTIVAR / ACTIVAR USUARIOS -->
                <Button
                    android:id="@+id/btnQuickToggleBloqueo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🚫 Desactivar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#D32F2F"
                    android:paddingHorizontal="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <TextView
                    android:id="@+id/btnGestionarUsuarioItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Permisos"
                    android:textColor="#DEFF9A"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
