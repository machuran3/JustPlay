<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#1A1C29"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- HEADER CON FECHA Y HORA ULTRA LEGIBLES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#24283B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvResHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 18:30"
                android:textColor="#DEFF9A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="🗓️ 24/05/2026"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minicine"
                android:textColor="#DEFF9A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#151722"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- CUERPO DE LA RESERVA -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/llInfoReserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/llAccionesReserva"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mauricio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResDetalles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cel: 77777777 | Tiempo: 120m"
                    android:textColor="#A0A0A0"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <!-- VOLANTES / CUPOS RESERVADOS -->
                <TextView
                    android:id="@+id/tvResVolantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏎️ Volantes reservados: 1"
                    android:textColor="#DEFF9A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <!-- ADELANTO -->
                <LinearLayout
                    android:id="@+id/llAdelantoContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResAdelanto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adelanto: 50 Bs (📱 QR)"
                        android:textColor="#FFC107"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVerComprobanteReserva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="📷 Ver Comprobante"
                        android:textColor="#DEFF9A"
                        android:textSize="11sp"
                        android:background="#2A2C39"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResHoraLlegada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Llegó a las: 18:25"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAccionesReserva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="end">

                <Button
                    android:id="@+id/btnMarcarAsistencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2979FF"
                    android:text="Asistencia"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnAsignarSala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#DEFF9A"
                    android:text="🎬 A Sala"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>